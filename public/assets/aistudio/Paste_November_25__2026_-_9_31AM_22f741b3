const SQ64 = new Uint8Array(64), SQ63 = new Uint8Array(63), SQ65 = new Uint8Array(65);
for (let i = 0; i < 64; i++) SQ64[(i * i) % 64] = 1;
for (let i = 0; i < 63; i++) SQ63[(i * i) % 63] = 1;
for (let i = 0; i < 65; i++) SQ65[(i * i) % 65] = 1;
/** Returns sqrt(q) if q is a perfect square, else 0. Rejects ~99% of non-squares without sqrt. */
export function squareRoot(q: number): number {
if (!SQ64[q & 63] || !SQ63[q % 63] || !SQ65[q % 65]) return 0;
const r = Math.round(Math.sqrt(q)); return r * r === q ? r : 0;
}
function gcd(a: number, b: number) { while (b) { const t = a % b; a = b; b = t; } return a; }
const MULTS = [1, 3, 5, 7, 11, 15, 21, 33, 35, 55, 77, 105, 165, 231, 385, 1155];
/** Non-trivial factor of an odd composite n < 2^52, or 0 on failure. */
export function squfof(n: number): number {
if (n % 2 === 0) return 2;
const rt = Math.floor(Math.sqrt(n)); if (rt * rt === n) return rt;
for (const k of MULTS) {
const D = k * n; if (D >= 4503599627370496) break;
const P0 = Math.floor(Math.sqrt(D)); let P = P0, Pprev = P0, Qprev = 1, Q = D - P0 * P0;
if (Q === 0) continue;
const L = 2 * Math.floor(Math.sqrt(2 * Math.sqrt(D))), B = 3 * L;
let i = 2, r = 0, b = 0, q = 0;
for (; i < B; i++) {
b = Math.floor((P0 + P) / Q); P = b * Q - P; q = Q; Q = Qprev + b * (Pprev - P);
if (!(i & 1) && (r = squareRoot(Q)) > 0) break;
Qprev = q; Pprev = P;
}
if (i >= B) continue;
b = Math.floor((P0 - P) / r); Pprev = P = b * r + P; Qprev = r; Q = (D - Pprev * Pprev) / Qprev;
let j = 0;
do { b = Math.floor((P0 + P) / Q); Pprev = P; P = b * Q - P; q = Q; Q = Qprev + b * (Pprev - P); Qprev = q; j++; } while (P !== Pprev && j < B);
const f = gcd(n, Qprev);
if (f !== 1 && f !== n) return f % k === 0 && f !== k ? f : f;
}
return 0;
}
