/** Factor base size and half-interval M (multiple of the 32 KB L1 block) by decimal digits. */
export function siqsParams(digits: number) {
const T: [number, number, number][] = [[30, 200, 1], [40, 450, 1], [50, 1100, 2], [60, 2200, 2], [70, 4000, 3], [80, 6500, 4], [90, 11000, 6], [100, 18000, 8], [120, 40000, 12], [160, 90000, 16], [250, 120000, 32]];
let i = 0; while (i < T.length - 2 && digits > T[i + 1]![0]) i++;
const [d0, f0, b0] = T[i]!, [d1, f1, b1] = T[i + 1]!;
const t = Math.min(1, Math.max(0, (digits - d0) / (d1 - d0)));
return { fbSize: Math.round(f0 + t * (f1 - f0)), blocks: Math.max(1, Math.round(b0 + t * (b1 - b0))) };
