const s = new Uint8Array(n + 1); const out: number[] = n >= 2 ? [2] : [];
for (let i = 3; i <= n; i += 2) if (!s[i]) { out.push(i); for (let j = i * i; j <= n; j += 2 * i) s[j] = 1; }
return Int32Array.from(out);
}
