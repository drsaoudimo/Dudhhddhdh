export type FactorBase = { primes: Int32Array; sqrts: Int32Array; logp: Uint8Array };
export function buildFactorBase(kN: bigint, size: number): FactorBase {
const P: number[] = [], S: number[] = [];
let lim = Math.max(1000, size * 30); let ps = primesUpTo(lim), i = 0;
while (P.length < size) {
if (i >= ps.length) { lim *= 2; ps = primesUpTo(lim); }
const p = ps[i++]!; if (p === undefined) continue;
const r = bmod(kN, p);
if (p === 2) { P.push(2); S.push(r & 1); continue; }
if (r === 0) { P.push(p); S.push(0); continue; }
if (powmod(r, (p - 1) / 2, p) === 1) { P.push(p); S.push(sqrtModP(r, p)); }
}
const primes = Int32Array.from(P);
return { primes, sqrts: Int32Array.from(S), logp: Uint8Array.from(P, (p) => Math.round(Math.log2(p))) };
}
