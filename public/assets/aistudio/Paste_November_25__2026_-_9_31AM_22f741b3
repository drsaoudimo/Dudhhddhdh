export function invMod(a: number, m: number): number {
let [r0, r1, t0, t1] = [((a % m) + m) % m, m, 1, 0];
while (r1) { const q = Math.floor(r0 / r1); [r0, r1] = [r1, r0 - q * r1]; [t0, t1] = [t1, t0 - q * t1]; }
return ((t0 % m) + m) % m;
}
/** Tonelli–Shanks: x with x^2 ≡ n (mod p), n is a QR. */
export function sqrtModP(n: number, p: number): number {
n %= p; if (p === 2 || n === 0) return n;
if (p % 4 === 3) return powmod(n, (p + 1) / 4, p);
