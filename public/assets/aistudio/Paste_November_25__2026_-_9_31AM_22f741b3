export function primesUpTo(n: number): Int32Array {
const s = new Uint8Array(n + 1); const out: number[] = n >= 2 ? [2] : [];
for (let i = 3; i <= n; i += 2) if (!s[i]) { out.push(i); for (let j = i * i; j <= n; j += 2 * i) s[j] = 1; }
return Int32Array.from(out);
}
// all operands < 2^26 so products stay exact in doubles
export function mulmod(a: number, b: number, m: number) { return (a * b) % m; }
export function powmod(b: number, e: number, m: number) { let r = 1; b %= m; while (e > 0) { if (e & 1) r = (r * b) % m; b = (b * b) % m; e = Math.floor(e / 2); } return r; }
export function invMod(a: number, m: number): number {
let [r0, r1, t0, t1] = [((a % m) + m) % m, m, 1, 0];
while (r1) { const q = Math.floor(r0 / r1); [r0, r1] = [r1, r0 - q * r1]; [t0, t1] = [t1, t0 - q * t1]; }
return ((t0 % m) + m) % m;
}
/** Tonelli–Shanks: x with x^2 ≡ n (mod p), n is a QR. */
export function sqrtModP(n: number, p: number): number {
n %= p; if (p === 2 || n === 0) return n;
if (p % 4 === 3) return powmod(n, (p + 1) / 4, p);
let q = p - 1, s = 0; while (q % 2 === 0) { q /= 2; s++; }
let z = 2; while (powmod(z, (p - 1) / 2, p) !== p - 1) z++;
let m = s, c = powmod(z, q, p), t = powmod(n, q, p), r = powmod(n, (q + 1) / 2, p);
while (t !== 1) { let i = 0, tt = t; while (tt !== 1) { tt = (tt * tt) % p; i++; }
let b = c; for (let j = 0; j < m - i - 1; j++) b = (b * b) % p;
m = i; c = (b * b) % p; t = (t * c) % p; r = (r * b) % p; }
return r;
}
export const bmod = (a: bigint, p: number) => { const r = Number(a % BigInt(p)); return r < 0 ? r + p : r; };
export function bitlen(n: bigint) { return n.toString(2).length; }
export function isqrtBig(n: bigint): bigint { if (n < 2n) return n; let x = BigInt(Math.floor(Math.sqrt(Number(n)))) ; if (x === 0n) x = 1n;
for (;;) { const y = (x + n / x) >> 1n; if (y >= x) { if (x * x > n) { x--; continue; } return x; } x = y; } }
/** Knuth–Schroeppel multiplier: maximises expected small-prime contribution of kN. */
export function knuthSchroeppel(N: bigint): number {
const ks = [1, 2, 3, 5, 6, 7, 10, 11, 13, 14, 15, 17, 19, 21, 22, 23, 26, 29, 30, 31, 33, 34, 35, 37, 38, 39, 41, 42, 43, 46, 47, 51, 53, 55, 57, 58, 59, 61, 62, 65, 66, 67, 69, 70, 71, 73];
const ps = primesUpTo(1000); let best = 1, bestF = -Infinity;
for (const k of ks) {
const kN = N * BigInt(k); const m8 = Number(kN % 8n);
let f = -0.5 * Math.log(k) + (m8 === 1 ? 2 * Math.log(2) : m8 === 5 ? Math.log(2) : m8 === 3 || m8 === 7 ? 0.5 * Math.log(2) : 0);
for (let i = 1; i < ps.length; i++) { const p = ps[i]!; const r = bmod(kN, p);
