5.1 الخوارزمية شبه البرمجية
Python
def ZSF196(N, zeros, candidates):
    # 1. Build spectral matrix
    A = []
    for gamma in zeros:
        row = [
            cos(gamma * log(x))
            for x in candidates
        ]
        A.append(row)

    # 2. Build pair compatibility scores
    scores = {}

    for x in candidates:
        if x <= 1 or x >= N:
            continue

        y, r = divmod(N, x)

        if r != 0:
            continue

        scores[x] = pair_spectral_score(
            N, x, zeros
        )

    # 3. Rank candidates
    ranked = sorted(
        scores,
        key=scores.get,
        reverse=True
    )

    # 4. Exact arithmetic verification
    for p in ranked:
        if N % p != 0:
            continue

        q = N // p

        if is_prime(p) and is_prime(q):
            return p, q

    return None
هذه خوارزمية هيكلية وليست محللاً عاماً فعالاً: فهي تفترض أن المرشحين قد أُنشئوا مسبقاً، كما أن اختبار القسمة لا يكفي لتجاوز مشكلة البحث عن المرشحين.
